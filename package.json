{
  "name": "koma",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html koma.html",
    "deploy": "bun run build && wrangler deploy",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:i18n": "bun scripts/check-i18n.ts",
    "lint:fix": "eslint . --fix",
    "up": "taze major -Ii",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "heic-to": "^1.6.5",
    "lucide": "^1.55.0",
    "morphicons": "^1.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.24.10",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.149.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx nano-staged",
    "commit-msg": "bunx commitlint --edit $1"
  },
  "nano-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
