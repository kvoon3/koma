{
  "name": "koma",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "bun run check-types && vite build",
    "build:single": "bun run check-types && vite build --mode single && cp dist/index.html koma.html",
    "deploy": "void deploy",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:storybook": "bun run build-storybook && wrangler deploy --config wrangler.storybook.jsonc",
    "dev:desktop": "mygo dev",
    "build:desktop": "mygo build",
    "i18n": "x18n check",
    "lint": "eslint . --cache --cache-strategy content --concurrency off",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --concurrency off",
    "check-types": "bun check && tsc -p tsconfig.void.json",
    "test": "bun test --check --isolate src routes",
    "test:shuffle": "bun test --check --isolate --randomize src routes",
    "ci": "bun run --no-exit-on-error --parallel lint test i18n build",
    "up": "taze major -Ii",
    "prepare": "simple-git-hooks",
    "doctor": "bunx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-router": "^1.170.45",
    "heic-to": "^1.6.6",
    "lucide": "^1.59.0",
    "morphicons": "^2.0.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.2",
    "@huggingface/transformers": "^4.3.1",
    "@shadcn/lint": "^0.2.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/devtools": "^0.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@x18n/cli": "^0.0.14",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "mygo-cli": "^0.5.5",
    "nano-staged": "^1.0.2",
    "react-doctor": "^0.9.18",
    "react-grab": "^0.2.0",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-singlefile": "^2.3.4",
    "void": "^1.3.0",
    "wrangler": "^4.151.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx nano-staged",
    "commit-msg": "bunx commitlint --edit $1",
    "post-checkout": "[ -f scripts/worktree-setup.sh ] && sh scripts/worktree-setup.sh"
  },
  "nano-staged": {
    "*": [
      "eslint --fix --cache --cache-strategy content --concurrency off"
    ],
    "*.{ts,tsx}": [
      "react-doctor --no-telemetry --blocking error",
      "sh -c \"bun run i18n\"",
      "sh -c \"bun run check-types\""
    ]
  }
}
