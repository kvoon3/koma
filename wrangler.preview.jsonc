{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koma-preview",
  "account_id": "28a23c2ec9aeeb01a95276f1d9ca42df",
  "compatibility_date": "2026-10-11",
  // Each PR overrides the name with --name koma-pr-<number>. Assets only: a
  // preview never touches the koma Worker, its domain, or its secrets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
